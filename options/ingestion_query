query ($page: Int) {
  locations(page: $page) {
    info {
      count
      pages
      next
      prev
    }
    results {
      id
      name
      type
      dimension
      residents {
        id
        name
        status
        species
        type
        gender
        image
        episode{
          id
          name
          episode
        }
      }
    }
  }
}

